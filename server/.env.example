PORT=3000
DATABASE_PATH=./data/bongii.db
JWT_SECRET=replace-with-a-long-random-development-secret
AUTH_MODE=legacy
# Required for AUTH_MODE=hybrid or firebase. Use the development Firebase project locally.
FIREBASE_PROJECT_ID=
# Set both service-account values, or use GOOGLE_APPLICATION_CREDENTIALS locally.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional for local development: 127.0.0.1:9099
FIREBASE_AUTH_EMULATOR_HOST=
# Deployments must add each exact Vercel production and preview origin.
CLIENT_ORIGINS=http://localhost:3001